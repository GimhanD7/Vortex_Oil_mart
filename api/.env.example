# Copy to .env on the server. Never commit the populated file.
APP_ENV="production"
APP_ORIGIN="https://pos.example.com"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="your_database_name"
MYSQL_USER="your_database_user"
MYSQL_PASSWORD=""
# Generate with: php -r "echo bin2hex(random_bytes(48));"
JWT_SECRET=""
# Optional, only for explicitly provisioning initial accounts with db:setup.
INITIAL_ADMIN_USERNAME=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_CASHIER_USERNAME=""
INITIAL_CASHIER_PASSWORD=""
