Options -Indexes
<FilesMatch "(?i)(^\.|\.(zip|sql|bak|log|ini)$|^(config|environment|auth_middleware|session|product-import|credit|test_db)\.php$)">
Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^routes/ - [F,L,NC]

# Pass Authorization header to PHP in cPanel / FastCGI / LiteSpeed
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?request=$1 [QSA,NC,L]
</IfModule>
