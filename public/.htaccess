Options -Indexes

<FilesMatch "(?i)(^\.env|\.(sql|zip|log|bak|pem|key)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule (^|/)(\.(?!well-known(?:/|$))[^/]+|node_modules|scripts)(/|$) - [F,L,NC]

  # 1. Do NOT touch API requests (handled by /api/.htaccess)
  RewriteRule ^api/ - [L]

  # 2. Existing real files (JS, CSS, images) -> serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Existing directory with index.html -> serve directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 4. Handle clean URLs (e.g. /dashboard -> /dashboard.html or /dashboard/)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 5. SPA Fallback for client-side routing & back/forward history navigation
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
